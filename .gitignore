# Data. The directories themselves are tracked, so the layout is visible on
# GitHub; everything placed in them is not.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Run logs
logs/

# Python
__pycache__/
*.py[cod]
.Python
build/
dist/
*.egg-info/
.venv/

# Jupyter
.ipynb_checkpoints/

# Boosting library scratch output
catboost_info/

# macOS
.DS_Store

# Machine-specific path overrides
configs/paths.local.yaml

# Internal working documents, not part of the published repository
docs/
